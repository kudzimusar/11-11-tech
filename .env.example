# Browser-safe configuration only. Never place service-role, Stripe secret,
# webhook-signing, email-provider or cron secrets in Vite/browser variables.
VITE_LEAD_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/lead-intake
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_COMMERCIAL_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Native public configuration. EXPO_PUBLIC_* values are bundled into the app,
# so only publishable/anonymous Supabase values and public function URLs belong here.
# Put these in mobile/.env.local for local UAT or the intended EAS environment.
EXPO_PUBLIC_LEAD_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/lead-intake
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
EXPO_PUBLIC_COMMERCIAL_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Supabase Auth redirect allow-list must include the production native callback:
# eleveneleven://client
# Also allow the exact Expo Go/dev callback produced by Linking.createURL('/client')
# during controlled simulator UAT. Remove temporary development redirects later.

# Server / Supabase Edge Function secrets (documentation only; configure them
# with Supabase secrets, not in a committed .env file):
# SUPABASE_SERVICE_ROLE_KEY=...
# STRIPE_SECRET_KEY=sk_test_...            # test mode first
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=...
# COMMERCIAL_FROM=11-11 Tech <billing@your-domain.example>
# PUBLIC_APP_URL=https://your-11-11-tech-domain.example
# ALLOWED_ORIGINS=https://your-11-11-tech-domain.example
# BILLING_CRON_SECRET=...
# DOCUMENT_RENDER_SECRET=...
