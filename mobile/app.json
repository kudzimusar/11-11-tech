{
  "expo": {
    "name": "11-11 Tech",
    "slug": "11-11-tech-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "eleveneleven",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.eleveneleven.tech" },
    "android": {
      "package": "com.eleveneleven.tech",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#050608" }
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/icon.png", "imageWidth": 160, "resizeMode": "contain", "backgroundColor": "#050608" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
