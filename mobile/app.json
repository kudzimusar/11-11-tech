{
  "expo": {
    "name": "11-11 Tech",
    "slug": "11-11-tech-mobile",
    "version": "1.1.0",
    "orientation": "default",
    "scheme": "eleveneleven",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eleveneleven.tech",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.eleveneleven.tech",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#050608" }
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", { "image": "./assets/icon.png", "imageWidth": 160, "resizeMode": "contain", "backgroundColor": "#050608", "dark": { "backgroundColor": "#050608", "image": "./assets/icon.png" } }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
